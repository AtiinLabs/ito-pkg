use ito_rs::Result;
use ito_rs::export_novel_plugin;
use ito_rs::provider::NovelProvider;
use ito_rs::models::{Listing, FilterItem, Page, HomeLayout};
use ito_rs::models::novel::{Novel, Chapter, PageResult};

struct MyNovelPlugin;

impl NovelProvider for MyNovelPlugin {
    fn get_home() -> Result<HomeLayout> {
        Ok(HomeLayout { components: vec![] })
    }

    fn get_novel_list(_listing: Listing, _page: i32) -> Result<PageResult> {
        Ok(PageResult { entries: vec![], has_next_page: false })
    }

    fn get_search_novel_list(_query: &str, _page: i32, _filters: Vec<FilterItem>) -> Result<PageResult> {
        Ok(PageResult { entries: vec![], has_next_page: false })
    }

    fn get_novel_update(novel: Novel, _needs_details: bool, _needs_chapters: bool) -> Result<Novel> {
        Ok(novel)
    }

    fn get_chapter_content(_novel: Novel, _chapter: Chapter) -> Result<Vec<Page>> {
        Ok(vec![])
    }
}

export_novel_plugin!(MyNovelPlugin);
