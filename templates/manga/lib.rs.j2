use ito_rs::Result;
use ito_rs::export_manga_plugin;
use ito_rs::provider::MangaProvider;
use ito_rs::models::{Listing, FilterItem, Page, HomeLayout};
use ito_rs::models::manga::{Manga, Chapter, PageResult};

struct MyMangaPlugin;

impl MangaProvider for MyMangaPlugin {
    fn get_home() -> Result<HomeLayout> {
        Ok(HomeLayout { components: vec![] })
    }

    fn get_manga_list(_listing: Listing, _page: i32) -> Result<PageResult> {
        Ok(PageResult { entries: vec![], has_next_page: false })
    }

    fn get_search_manga_list(_query: &str, _page: i32, _filters: Vec<FilterItem>) -> Result<PageResult> {
        Ok(PageResult { entries: vec![], has_next_page: false })
    }

    fn get_manga_update(manga: Manga, _needs_details: bool, _needs_chapters: bool) -> Result<Manga> {
        Ok(manga)
    }

    fn get_page_list(_manga: Manga, _chapter: Chapter) -> Result<Vec<Page>> {
        Ok(vec![])
    }
}

export_manga_plugin!(MyMangaPlugin);
